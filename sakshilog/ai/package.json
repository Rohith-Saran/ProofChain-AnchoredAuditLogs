{
  "name": "@sakshilog/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SakshiLog AI incident investigator: one LLM call over the verifier's own verdicts, every claim cites a log entry, a citation checker blocks anything the chain can't prove",
  "main": "src/server.ts",
  "scripts": {
    "start": "node --env-file-if-exists=.env --experimental-strip-types src/server.ts",
    "test": "node --experimental-strip-types test-investigator.ts && node --experimental-strip-types test-features.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3"
  }
}
