# Copy to ai/.env (gitignored — never commit the real file) and fill in ONE key.
# `npm run start:ai` loads this file automatically.

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Default: openai/gpt-oss-120b (production model with strict JSON-schema output).
# GROQ_MODEL=openai/gpt-oss-120b

# Or Anthropic (Claude): https://platform.claude.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: force a provider when both keys are set ("groq" or "anthropic").
# AI_PROVIDER=groq
