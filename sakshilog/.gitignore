# Dependencies
node_modules/
*/node_modules/
**/node_modules/

# Build outputs
dist/
*/dist/
**/dist/
build/
*/build/
**/build/
out/
*/out/
**/out/
*.tsbuildinfo

# Sensitive files & environment variables
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
*.secret
*.key
*.pem
*.pk
*.keystore
credentials.json

# Logs
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Databases (SQLite victim & collector stores)
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
victim.db
collector.db
tmp*.db*
tmp-*.db*
*.bak
*.backup

# Blockchain / Hardhat artifacts
contracts/artifacts/
contracts/cache/
contracts/typechain-types/
contracts/deployments/
*/artifacts/
*/cache/
*/typechain-types/
*/deployments/
**/artifacts/
**/cache/
**/typechain-types/
**/deployments/

# Test & benchmark temporary files
tmp/
temp/
tmp-*/
*.tmp
tmp*
scratch/
.cache/
.vitest/
coverage/
.nyc_output/
bench/results/*.tmp
bench/results/*.csv.tmp
evidence-pack*.json
evidence-pack*-report.md
test-phase*.ts
test-tmp*.ts
tmp-*.ts

# OS / Editor / Agent files
.DS_Store
Thumbs.db
