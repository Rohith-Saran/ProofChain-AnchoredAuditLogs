# ==============================================================================
# SakshiLog - Subdirectory .gitignore
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/

# Build outputs
dist/
build/
out/
*.tsbuildinfo

# Sensitive files & environment variables
.env
.env.*
*.env
*.secret
*.key
*.pem
*.pk
*.keystore
credentials.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Databases (SQLite victim & collector stores)
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
victim.db
collector.db

# Blockchain / Hardhat artifacts
contracts/artifacts/
contracts/cache/
contracts/typechain-types/
contracts/deployments/

# Test & benchmark temporary files
tmp/
temp/
tmp-*/
*.tmp
bench/results/*.tmp
bench/results/*.csv.tmp
evidence-pack*.json
evidence-pack*-report.md

# OS / Editor files
.DS_Store
Thumbs.db
[Dd]esktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo
*~
