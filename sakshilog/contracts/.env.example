# Copy to .env (gitignored - never commit the real file) before running npm run deploy:quai.
# See QUAI_DEPLOYMENT.md for the full walkthrough.

# Orchard testnet RPC (base URL form; quais' JsonRpcProvider routes it with usePathing).
# Verify this against https://docs.qu.ai/ before using it - never from a pasted link.
RPC_URL=https://orchard.rpc.quai.network

# Orchard testnet chain ID (see implementation/PROGRESS.md, M1 log).
CHAIN_ID=15000

# A DEDICATED, NEWLY GENERATED testnet wallet's private key - never a key that holds
# real funds, never reused from anywhere else, never shared/committed/pasted into chat.
# Generate one with: npm run quai:wallet
CYPRUS1_PK=

# Optional: overrides the anchorer address AnchorRegistry is deployed with. If unset,
# the deployer's own address (derived from CYPRUS1_PK) is used.
# ANCHORER_ADDRESS=
